{
  "name": "coalguard",
  "version": "0.0.0",
  "private": true,
  "description": "CoalGuard AI - smart governance & compliance monitoring for the Indian coal mining ecosystem",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "web": "npm run dev --workspace @coalguard/web",
    "web:build": "npm run build --workspace @coalguard/web",
    "mobile": "npm run start --workspace @coalguard/mobile",
    "demo:reset": "node supabase/seed/demo-seed.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "build": "npm run build --workspace @coalguard/web",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
