# ============================================================================
# CoalGuard AI - Environment variables (SAMPLE)
# ----------------------------------------------------------------------------
# 1. Copy this file:   cp .env.example .env
# 2. Also copy it into each app that needs it:
#       cp .env.example apps/web/.env.local
#       cp .env.example apps/mobile/.env
# 3. Fill in the values from your Supabase project (Settings -> API).
# 4. NEVER commit the real .env / .env.local files. They are git-ignored.
# ============================================================================

# ---------------------------------------------------------------------------
# PUBLIC - safe to expose to the browser AND the mobile app.
# The "NEXT_PUBLIC_" prefix = shipped to the web client bundle.
# The "EXPO_PUBLIC_" prefix = shipped to the mobile client bundle.
# Keep both in sync; they point at the same Supabase project.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------------
# SERVER ONLY - must NEVER reach the browser or the phone.
# Used only inside Next.js API routes / server code (apps/web).
# The service role key bypasses Row Level Security - treat it like a password.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ---------------------------------------------------------------------------
# AI provider (SERVER ONLY) - wired up in a later phase.
# For Phase 0 leave AI_PROVIDER=mock so nothing external is called.
# ---------------------------------------------------------------------------
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=

# ---------------------------------------------------------------------------
# OCR provider (SERVER ONLY) - wired up in a later phase.
# ---------------------------------------------------------------------------
OCR_PROVIDER=mock
